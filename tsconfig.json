{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/engine/*"],
      "@renderer/*": ["src/renderer/*"],
      "@sensors/*": ["src/sensors/*"],
      "@ui/*": ["src/ui/*"]
    }
  },
  "include": ["src"]
}
